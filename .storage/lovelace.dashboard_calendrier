                  }
                },
                {
                  "type": "markdown",
                  "content": "{% macro bissextile(y) %}{{ y % 4 == 0 and (y % 100 != 0 or y % 400 == 0) }}{% endmacro %}\n{% macro date_sure(y, m, d) %}\n  {% if m == 2 and d == 29 and bissextile(y) | trim != 'True' %}\n    {{ '%04d-%02d-%02d' | format(y, 2, 28) }}\n  {% else %}\n    {{ '%04d-%02d-%02d' | format(y, m, d) }}\n  {% endif %}\n{% endmacro %}\n{% set personnes = [\n  ('Grégory', 'input_datetime.anniversaire_gregory'),\n  ('Sandrine', 'input_datetime.anniversaire_sandrine'),\n  ('Matteo', 'input_datetime.anniversaire_matteo'),\n  ('Hugo', 'input_datetime.anniversaire_hugo')\n] %}\n{% set today = now().date() %} {% set ns = namespace(liste=[]) %}\n{% for nom, ent in personnes %}\n  {% if states(ent) not in ['unknown','unavailable',''] %}\n    {% set d = strptime(states(ent), '%Y-%m-%d').date() %}\n    {% set prochain = strptime(date_sure(today.year, d.month, d.day) | trim, '%Y-%m-%d').date() %}\n    {% set prochain = prochain if prochain >= today else strptime(date_sure(today.year + 1, d.month, d.day) | trim, '%Y-%m-%d').date() %}\n    {% set jours = (prochain - today).days %}\n    {% set age = prochain.year - d.year %}\n    {% set ns.liste = ns.liste + [(jours, nom, prochain, age)] %}\n  {% endif %}\n{% endfor %}\n{% if ns.liste | count == 0 %}\n  ℹ️ Aucun input_datetime d'anniversaire configuré pour l'instant.\n{% else %}\n  {% for jours, nom, prochain, age in ns.liste | sort %}\n    {% if jours == 0 %}\n      🎉 **{{ nom }}** fête ses **{{ age }} ans** aujourd'hui !\n    {% else %}\n      🎂 **{{ nom }}** — {{ age }} ans dans **{{ jours }} jour(s)** ({{ prochain.strftime('%d/%m') }})\n    {% endif %}\n  {% endfor %}\n{% endif %}",
