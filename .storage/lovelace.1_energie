{"version":1,"minor_version":1,"key":"lovelace.1_energie","data":{"config":{"title":"Énergie","background":{"image":"/local/images/wallpaper/energie.jpg","size":"cover","attachment":"fixed"},"views":[{"type":"sections","title":"Énergie","path":"energie","icon":"mdi:flash","max_columns":4,"badges":[{"type":"entity","entity":"select.consommation_maison"},{"type":"entity","entity":"sensor.buanderie_local_tech_compteur_general_maison_puissance"},{"type":"entity","entity":"sensor.buanderie_local_tech_compteur_general_maison_aujourd_hui"}],"header":{"card":{"type":"markdown","content":"# ⚡ Énergie\nTarif actif, consommation en direct, coûts depuis votre dernier\nrelevé et tendances de consommation.","text_only":true,"card_mod":{"style":"ha-card { background: rgba(25, 18, 38, 0.72) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; box-shadow: none !important; padding: 12px 20px !important; }\nha-markdown { text-align: center !important; text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,1) !important; color: #f6d68a !important; }\n"}}},"sections":[{"type":"grid","cards":[{"type":"custom:mushroom-title-card","title":"Tarif en cours","card_mod":{"style":"ha-card { background: rgba(25, 18, 38, 0.72) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; box-shadow: none !important; padding: 12px 20px !important; }\nha-markdown { text-align: center !important; text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,1) !important; color: #f6d68a !important; }\n"}},{"type":"markdown","content":"<img src=\"https://luna.be/wp-content/uploads/2025/08/2025-Mega-logo.png\" alt=\"Mega Energie\" style=\"max-height:36px; display:block; margin:0 auto;\">","grid_options":{"columns":12,"rows":"auto"},"card_mod":{"style":"ha-card { background: rgba(60, 40, 90, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-back