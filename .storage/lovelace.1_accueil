                  "card_mod": {
                    "style": {
                      ".": "ha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n",
                      "mushroom-state-info": {
                        "$": ".secondary, .primary { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                      }
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "timer.compte_a_rebours_depart",
                      "state": "active"
                    }
                  ],
                  "card": {
                    "type": "entities",
                    "title": "⏳ Armement de l'alarme dans...",
                    "entities": [
                      {
                        "entity": "timer.compte_a_rebours_depart",
                        "name": "Départ en cours",
                        "icon": "mdi:timer-alert"
                      }
                    ],
                    "card_mod": {
                      "style": "ha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n"
                    }
                  },
                  "grid_options": {
                    "columns": 12,
                    "rows": 2
                  }
                }
              ]
            },
            {
              "type": "grid",
              "visibility": [
                {
                  "condition": "numeric_state",
                  "entity": "sensor.maison_distance_de_foudre",
                  "below": 150
                }
              ],
              "cards": [
                {
                  "type": "custom:mushroom-title-card",
                  "title": "⛈️ Orage à proximité",
                  "subtitle": "{% set d = states('sensor.maison_distance_de_foudre') %} {% set a = states('sensor.maison_azimut_de_foudre') %} {% set c = states('sensor.maison_compteur_de_foudre') %} {{ d if is_number(d) else '--' }} km · azimut {{ a if is_number(a) else '--' }}° · {{ c if is_number(c) else '0' }} impact(s) détecté(s)",
                  "alignment": "center",
                  "card_mod": {
                    "style": ":host {\n  --primary-text-color: #f6d68a !important;\n  --secondary-text-color: #d9c4f0 !important;\n  --card-mod-icon-color: #f6d68a !important;\n}\nha-card {\n  text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,1) !important;\n  background: rgba(25, 18, 38, 0.72) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  box-shadow: none !important;\n}\n"
                  }
                },
                {
                  "type": "custom:blitzortung-lightning-card",
                  "title": "Impacts de foudre",
                  "distance_entity": "sensor.maison_distance_de_foudre",
                  "counter_entity": "sensor.maison_compteur_de_foudre",
                  "azimuth_entity": "sensor.maison_azimut_de_foudre",
                  "lightning_detection_radius": 250,
                  "always_show_full_card": true,
                  "show_compass": true,
                  "show_radar": true,
                  "period": "30m",
                  "grid_color": "#d9c4f0",
                  "font_color": "#d9c4f0",
                  "strike_color": "#f6d68a",
                  "show_history_chart": true,
                  "invert_history_direction": true,
                  "show_map": true,
                  "map_theme_mode": "dark",
                  "map_marker_style": "crosshair",
                  "map_height": "360px",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n"
                  }
                },
                {
                  "type": "iframe",
                  "url": "https://www.windy.com/?rain,50.583,5.317,8",
                  "aspect_ratio": "65%",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; overflow: hidden !important; }"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:mushroom-title-card",
                  "title": "Températures de la maison",
                  "subtitle": "Touchez une pièce pour son détail confort/chauffage",
                  "alignment": "center",
                  "card_mod": {
                    "style": ":host {\n  --primary-text-color: #f6d68a !important;\n  --secondary-text-color: #d9c4f0 !important;\n  --card-mod-icon-color: #f6d68a !important;\n}\nha-card {\n  text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,1) !important;\n  background: rgba(25, 18, 38, 0.72) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  box-shadow: none !important;\n}\n"
                  }
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "entity": "sensor.salon_temperature",
                  "name": "Salon",
                  "icon": "mdi:sofa",
                  "icon_color": "orange",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n"
                  }
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "entity": "sensor.chambre_temperature",
                  "name": "Chambre",
                  "icon": "mdi:bed",
                  "icon_color": "blue",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "markdown",
                  "content": "<!-- versioning-footer -->\n<div style=\"text-align:center;font-size:0.72em;opacity:0.55;line-height:1.7;margin-top:10px;padding-top:8px;border-top:1px solid var(--divider-color);\">\n🔧 <b>1_accueil</b> &middot; v{{ state_attr('sensor.versions_config_ha', \n    '.storage/lovelace.1_accueil').version if \n   state_attr('sensor.versions_config_ha', '.storage/lovelace.1_accueil') \n   else '0.0.0' }} &middot; {{\n  as_timestamp(state_attr('sensor.versions_config_ha',\n  '.storage/lovelace.1_energie').last_update) | timestamp_custom('%d/%m/%Y a\n  %H:%M') if state_attr('sensor.versions_config_ha',\n  '.storage/lovelace.1_accueil') else 'non versionne' }}<br>\nConçu et maintenu par <b>Gregory</b> via Claude AI\n</div>",
                  "grid_options": {
                    "columns": 36,
                    "rows": "auto"
                  }
                }
              ],
              "column_span": 4
            }
          ]
        }
      ]
    }
  }
}