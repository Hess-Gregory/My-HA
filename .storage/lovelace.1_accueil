                {
                  "type": "custom:mushroom-template-card",
                  "layout": "vertical",
                  "entity": "weather.forecast_maison",
                  "primary": "Vent",
                  "secondary": "{% set w_raw = state_attr('weather.forecast_maison', 'wind_speed') %} {% if is_number(w_raw) %}\n  {% set w = w_raw | float %}\n  {% if w > 60 %}💨 Vent fort ({{ w | round(0) }} km/h) — rentrez le parasol et protégez les plantes !\n  {% elif w > 35 %}🍃 Vent modéré ({{ w | round(0) }} km/h) — surveillez le parasol\n  {% else %}😌 Vent calme ({{ w | round(0) }} km/h){% endif %}\n{% else %}\n  ⏳ Données de vent indisponibles\n{% endif %}",
                  "icon": "mdi:weather-windy",
                  "icon_color": "{% set w_raw = state_attr('weather.forecast_maison', 'wind_speed') %} {% if is_number(w_raw) %}\n  {% set w = w_raw | float %}\n  {% if w > 60 %}red{% elif w > 35 %}amber{% else %}green{% endif %}\n{% else %}grey{% endif %}",
                  "grid_options": {
                    "columns": 12,
                    "rows": 2
                  },
                  "card_mod": {
                    "style": "ha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n} .container.fixed-height { height: auto !important; min-height: 56px !important; } .content.fixed-info-height { height: auto !important; } ha-tile-info span { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
