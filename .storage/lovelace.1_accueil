                  "type": "custom:mushroom-template-card",
                  "primary": "Gregory",
                  "secondary": "{% set home = is_state('person.greg', 'home') %} {% set eta = states('sensor.trajet_greg_waze_trajet_greg_vers_maison') %} {% set eta_ok = eta not in ['unknown','unavailable','none',''] and is_number(eta) %} {% if home %}est à la maison {% elif eta_ok %}\n  {% set s = (eta | float(0) * 60) | round(0) | int %}\n  {% if s < 60 %}est arrivé dans la rue, il se gare.\n  {% elif s < 120 %}est dans la rue avoisinante, arrivée imminente !\n  {% else %}{% set h = s // 3600 %}{% set m = (s % 3600) // 60 %}{% set sec = s % 60 %}il arrive dans {{ '%02d:%02d:%02d' | format(h, m, sec) }}\n  {% endif %}\n{% else %}est absent{% endif %}",
                  "picture": "{{ state_attr('person.greg', 'entity_picture') }}",
                  "icon": "mdi:account",
                  "badge_icon": "{% set home = is_state('person.greg', 'home') %} {% set eta = states('sensor.trajet_greg_waze_trajet_greg_vers_maison') %} {% set eta_ok = eta not in ['unknown','unavailable','none',''] and is_number(eta) %} {% if home %}mdi:check-bold {% elif eta_ok %}\n  {% set s = (eta | float(0) * 60) | round(0) | int %}\n  {% if s < 60 %}mdi:parking{% elif s < 120 %}mdi:map-marker-distance{% else %}mdi:car{% endif %}\n{% else %}mdi:account-off{% endif %}",
