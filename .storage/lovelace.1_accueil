                  "icon": "{% set s = states('alarm_control_panel.buanderie_local_tech_centrale_alarme_ajax') %} {{ 'mdi:shield-alert' if s == 'triggered' else 'mdi:shield-lock' if s in ['armed_home','armed_away','armed_night'] else 'mdi:shield-off-outline' }}",
