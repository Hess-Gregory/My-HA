                  "styles": ":host {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 296px;\n  margin: 0 auto;\n  padding: 16px 18px 18px;\n  /* 1. Coque Blanche Laquée Brillante */\n  background: linear-gradient(180deg, #ffffff 0%, #f5f5f9 45%, #e6e6ee 100%);\n  border-radius: 34px;\n  border: 1px solid rgba(255, 255, 255, 0.8);\n  box-shadow:\n    0 14px 35px rgba(0, 0, 0, 0.15),\n    inset 0 3px 4px rgba(255, 255, 255, 1),\n    inset 0 -4px 6px rgba(0, 0, 0, 0.05);\n  gap: 9px;\n}\n.row {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 9px;\n  width: 100%;\n}\n/* 2. Style de base de TOUTES les touches en Silicone Blanc */ remote-button {\n  /* Forcer la couleur par défaut */\n  --icon-color: #4a4a5a !important;\n  color: #4a4a5a !important;\n  --icon-size: 18px;\n\n  /* Aspect silicone mat en relief */\n  background: linear-gradient(145deg, #ffffff 0%, #f6f6f9 100%) !important;\n  box-shadow:\n    2px 2px 4px rgba(0, 0, 0, 0.12),\n    -1px -1px 3px rgba(255, 255, 255, 0.9),\n    inset 1px 1px 2px rgba(255, 255, 255, 1) !important;\n  border: none !important;\n  transition: all 0.1s ease;\n}\n/* CIBLAGE GLOBAL DU CLAVIER NUMÉRIQUE & TEXTES : Force TOUT le contenu des boutons à devenir gris foncé */ remote-button *, remote-button div, remote-button span, remote-button p, remote-button ha-icon, remote-button ha-svg-icon, remote-button svg, remote-button .icon, remote-button .label {\n  color: #4a4a5a !important;\n  fill: #4a4a5a !important;\n}\n/* Effet mécanique de clic */ remote-button:active {\n  transform: scale(0.96);\n  box-shadow:\n    inset 2px 2px 4px rgba(0, 0, 0, 0.12),\n    inset -1px -1px 3px rgba(255, 255, 255, 0.6) !important;\n}\nremote-button .label {\n  font-weight: 600;\n  font-size: 13px;\n  font-family: inherit;\n}\n/* FIX chiffres invisibles : le label (\"1\", \"2\", ... \"CH\") est rendu dans le shadow DOM du composant remote-button en tant que shadow part, donc les sélecteurs classiques ci-dessus ne l'atteignent pas et il restait blanc sur fond blanc. Seul ::part() traverse cette frontière. */ remote-button::part(label) {\n  color: #4a4a5a !important;\n  font-weight: 600;\n  font-family: inherit;\n}\n/* --- TOUCHES SPÉCIFIQUES --- */\n#power {\n  border-radius: 50%;\n  width: 44px;\n  height: 44px;\n  background: linear-gradient(145deg, #ff6b6b 0%, #e63946 100%) !important;\n  box-shadow:\n    2px 2px 4px rgba(0, 0, 0, 0.15),\n    inset 1px 1px 2px rgba(255, 255, 255, 0.4) !important;\n  --icon-color: #ffffff !important;\n  --icon-size: 20px;\n} /* Exception pour que le Power reste blanc */ #power *, #power ha-icon, #power ha-svg-icon, #power svg {\n  color: #ffffff !important;\n  fill: #ffffff !important;\n} #power:active {\n  box-shadow: inset 2px 2px 5px rgba(0, 0, 0, 0.3) !important;\n}\n#search {\n  border-radius: 50%;\n  width: 44px;\n  height: 44px;\n  --icon-color: #dca000 !important;\n  --icon-size: 18px;\n} /* Exception pour l'icône loupe dorée */ #search *, #search ha-icon, #search ha-svg-icon, #search svg {\n  color: #dca000 !important;\n  fill: #dca000 !important;\n}\n#guide {\n  border-radius: 50%;\n  width: 44px;\n  height: 44px;\n  --icon-size: 17px;\n}\n#back {\n  border-radius: 20px;\n  padding: 6px 18px;\n  --icon-size: 17px;\n}\n#home {\n  border-radius: 50%;\n  width: 48px;\n  height: 48px;\n  padding: 0;\n  background-color: #ff7900 !important;\n  background-image: url(\"/local/images/logos/orange.png\") !important;\n  background-size: 80%;\n  background-position: center;\n  background-repeat: no-repeat;\n  box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15) !important;\n  --icon-size: 0px;\n}\n#netflix, #youtube {\n  border-radius: 12px;\n  width: 48px;\n  height: 34px;\n  box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15) !important;\n}\n#netflix {\n  background: #a30f16 !important;\n}\n#youtube {\n  background: #1c1c1c !important;\n}\n/* Barrettes doubles (Volume & Chaînes) */ #volume_down, #volume_up, #channel_down, #channel_up {\n  width: 68px;\n  height: 34px;\n  --icon-size: 16px;\n} #volume_down {\n  border-radius: 17px 4px 4px 17px;\n} #volume_up {\n  border-radius: 4px 17px 17px 4px;\n  margin-right: 8px;\n} #channel_down {\n  border-radius: 17px 4px 4px 17px;\n} #channel_up {\n  border-radius: 4px 17px 17px 4px;\n}\n#rewind, #fast_forward, #stop {\n  border-radius: 50%;\n  width: 36px;\n  height: 36px;\n  --icon-size: 15px;\n}\n#play_pause {\n  border-radius: 50%;\n  width: 40px;\n  height: 40px;\n  --icon-size: 18px;\n}\n#record {\n  border-radius: 50%;\n  width: 40px;\n  height: 40px;\n  background: linear-gradient(145deg, #ff4d4d 0%, #cc0000 100%) !important;\n  box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15) !important;\n  --icon-color: #ffffff !important;\n  --icon-size: 18px;\n} /* Exception pour Record blanc */ #record *, #record ha-icon, #record ha-svg-icon, #record svg {\n  color: #ffffff !important;\n  fill: #ffffff !important;\n}\n/* Clavier numérique */ #one, #two, #three, #four, #five, #six, #seven, #eight, #nine, #zero {\n  border-radius: 50%;\n  width: 36px;\n  height: 36px;\n}\n",
