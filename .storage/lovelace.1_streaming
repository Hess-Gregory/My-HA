on":"mdi:volume-plus","tap_action":{"action":"perform-action","perform_action":"media_player.volume_up","target":{"entity_id":"media_player.room_ampli_cine_zone2"}},"hold_action":{"action":"repeat"}}],"styles":":host {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 262px;\n  margin: 0 auto;\n  padding: 14px 16px 16px;\n  background: linear-gradient(180deg, #48484d 0%, #2e2e32 10%, #1d1d20 65%, #131315 100%);\n  border-radius: 28px;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.55), inset 0 2px 2px rgba(255, 255, 255, 0.07), inset 0 -3px 6px rgba(0, 0, 0, 0.5);\n  gap: 7px;\n}\n:host::before {\n  content: \"\";\n  width: 34px;\n  height: 5px;\n  border-radius: 3px;\n  background: linear-gradient(180deg, #050506 0%, #1c1c1f 100%);\n  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.85);\n  margin-bottom: 3px;\n}\n.row {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 7px;\n  width: 100%;\n}\nremote-button {\n  --icon-color: #d6d6dc;\n  --icon-size: 18px;\n  background: linear-gradient(145deg, #3a3a3f 0%, #202023 100%);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 3px 6px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.08);\n}\nremote-button .label {\n  color: #d6d6dc;\n  font-weight: 600;\n  font-size: 12px;\n  font-family: inherit;\n}\n#divider_sound, #divider_zone2 {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;\n  border-radius: 0 !important;\n  width: 100%;\n  height: auto;\n  padding: 6px 0 0 !important;\n  margin-top: 2px;\n}\n#divider_sound .label, #divider_zone2 .label {\n  color: rgba(214, 214, 220, 0.4);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 2px;\n}\n#power {\n  border-radius: 50%;\n  width: 46px;\n  height: 46px;\n  background: radial-gradient(circle at 35% 30%, #4a3a3a 0%, #201414 75%);\n  border: 1px solid rgba(255, 130, 120, 0.3);\n  --icon-color: #ff8f7a;\n  --icon-size: 20px;\n}\n#source, #drc {\n  border-radius: 18px;\n  padding: 7px 14px;\n  height: 34px;\n}\n#drc {\n  --icon-color: #8fd0e8;\n}\n#source .label, #drc .label {\n  color: #d6d6dc;\n}\n#volume_down, #volume_up {\n  width: 90px;\n  height: 38px;\n}\n#volume_down {\n  border-radius: 19px 4px 4px 19px;\n}\n#volume_up {\n  border-radius: 4px 19px 19px 4px;\n}\n#mute {\n  border-radius: 20px;\n  width: 60px;\n  height: 34px;\n  --icon-color: #e89a8f;\n}\n#pure_direct, #enhancer, #extra_bass {\n  border-radius: 18px;\n  padding: 7px 14px;\n  height: 34px;\n  min-width: 96px;\n}\n#party_mode {\n  border-radius: 18px;\n  padding: 7px 14px;\n  height: 34px;\n  min-width: 96px;\n  --icon-color: #d9a4f0;\n}\n#zone2_power {\n  border-radius: 18px;\n  padding: 7px 16px;\n  height: 34px;\n  background: linear-gradient(145deg, #2e3a44 0%, #1a2228 100%);\n  border: 1px solid rgba(143, 208, 232, 0.25);\n  --icon-color: #8fd0e8;\n}\n#zone2_power .label {\n  color: #8fd0e8;\n}\n#zone2_volume_down, #zone2_volume_up {\n  width: 72px;\n  height: 34px;\n  background: linear-gradient(145deg, #2e3a44 0%, #1a2228 100%);\n  border: 1px solid rgba(143, 208, 232, 0.2);\n  --icon-color: #8fd0e8;\n}\n#zone2_volume_down {\n  border-radius: 17px 4px 4px 17px;\n}\n#zone2_volume_up {\n  border-radius: 4px 17px 17px 4px;\n}","grid_options":{"columns":48,"rows":"auto"},"card_mod":{"style":"ha-card { background: transparent !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; border: none !important; box-shadow: none !important; }\n"}},{"type":"entities","title":"Son / Dialogue","entities":[{"entity":"number.ampli_cine_dialogue_level","name":"Dialogue Level","card_mod":{"style":"ha-slider { min-width: 56px !important; width: 56px !important; } .state { min-width: 26px !important; text-align: right; }"}},{"entity":"number.ampli_cine_dialogue_lift","name":"Dialogue Lift","card_mod":{"s