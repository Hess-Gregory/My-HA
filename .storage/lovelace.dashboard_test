assiques ci-dessus ne l'atteignent pas et il restait blanc sur fond blanc. Seul ::part() traverse cette frontière. */ remote-button::part(label) {\n  color: #4a4a5a !important;\n  font-weight: 600;\n  font-family: inherit;\n}\n/* --- TOUCHES SPÉCIFIQUES --- */\n#power {\n  border-radius: 50%;\n  width: 44px;\n  height: 44px;\n  background: linear-gradient(145deg, #ff6b6b 0%, #e63946 100%) !important;\n  box-shadow:\n    2px 2px 4px rgba(0, 0, 0, 0.15),\n    inset 1px 1px 2px rgba(255, 255, 255, 0.4) !important;\n  --icon-color: #ffffff !important;\n  --icon-size: 20px;\n} /* Exception pour que le Power reste blanc */ #power *, #power ha-icon, #power ha-svg-icon, #power svg {\n  color: #ffffff !important;\n  fill: #ffffff !important;\n} #power:active {\n  box-shadow: inset 2px 2px 5px rgba(0, 0, 0, 0.3) !important;\n}\n#search {\n  border-radius: 50%;\n  width: 44px;\n  height: 44px;\n  --icon-color: #dca000 !important;\n  --icon-size: 18px;\n} /* Exception pour l'icône loupe dorée */ #search *, #search ha-icon, #search ha-svg-icon, #search svg {\n  color: #dca000 !important;\n  fill: #dca000 !important;\n}\n#guide {\n  border-radius: 50%;\n  width: 44px;\n  height: 44px;\n  --icon-size: 17px;\n}\n#back {\n  border-radius: 20px;\n  padding: 6px 18px;\n  --icon-size: 17px;\n}\n#home {\n  border-radius: 50%;\n  width: 48px;\n  height: 48px;\n  padding: 0;\n  background-color: #ff7900 !important;\n  background-image: url(\"/local/images/logos/orange.png\") !important;\n  background-size: 80%;\n  background-position: center;\n  background-repeat: no-repeat;\n  box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15) !important;\n  --icon-size: 0px;\n}\n#netflix, #youtube {\n  border-radius: 12px;\n  width: 48px;\n  height: 34px;\n  box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15) !important;\n}\n#netflix {\n  background: #a30f16 !important;\n}\n#youtube {\n  background: #1c1c1c !important;\n}\n/* Barrettes doubles (Volume & Chaînes) */ #volume_down, #volume_up, #channel_down, #channel_up {\n  width: 68px;\n  height: 34px;\n  --icon-size: 16px;\n} #volume_down {\n  border-radius: 17px 4px 4px 17px;\n} #volume_up {\n  border-radius: 4px 17px 17px 4px;\n  margin-right: 8px;\n} #channel_down {\n  border-radius: 17px 4px 4px 17px;\n} #channel_up {\n  border-radius: 4px 17px 17px 4px;\n}\n#rewind, #fast_forward, #stop {\n  border-radius: 50%;\n  width: 36px;\n  height: 36px;\n  --icon-size: 15px;\n}\n#play_pause {\n  border-radius: 50%;\n  width: 40px;\n  height: 40px;\n  --icon-size: 18px;\n}\n#record {\n  border-radius: 50%;\n  width: 40px;\n  height: 40px;\n  background: linear-gradient(145deg, #ff4d4d 0%, #cc0000 100%) !important;\n  box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15) !important;\n  --icon-color: #ffffff !important;\n  --icon-size: 18px;\n} /* Exception pour Record blanc */ #record *, #record ha-icon, #record ha-svg-icon, #record svg {\n  color: #ffffff !important;\n  fill: #ffffff !important;\n}\n/* Clavier numérique */ #one, #two, #three, #four, #five, #six, #seven, #eight, #nine, #zero {\n  border-radius: 50%;\n  width: 36px;\n  height: 36px;\n}\n\n/* Touches volume et chaînes : arrondies sur les 4 coins */\n.column remote-button, remote-button#volume_up, remote-button#volume_down, remote-button#channel_up, remote-button#channel_down, remote-button#zone2_volume_up, remote-button#zone2_volume_down {\n  border-radius: 18px !important;\n  overflow: hidden;\n}\n.column remote-button button, .column remote-button md-ripple { border-radius: 18px !important; }\n.column { gap: 8px !important; }\n",
