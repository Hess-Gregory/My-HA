                "box-shadow": "none"
              },
              {
                "backdrop-filter": "none"
              },
              {
                "-webkit-backdrop-filter": "none"
              },
              {
                "border-radius": "0"
              }
            ]
          }
        },
        "cc_push": {
          "show_label": true,
          "extra_styles": "ha-card{transition:transform .08s,box-shadow .08s} ha-card:active{transform:translateY(4px)} ha-card:active{box-shadow:0 1px 0 #120b1e!important}",
          "variables": {
            "c1": "#9b78e0",
            "c2": "#5b3f99",
            "c3": "#3a2766"
          },
          "styles": {
            "card": [
              {
                "background": "linear-gradient(180deg, rgba(78,60,112,.92) 0%, rgba(40,29,62,.92) 100%)"
              },
              {
                "backdrop-filter": "blur(16px)"
              },
              {
                "border-radius": "16px"
              },
              {
                "border": "1px solid rgba(246,214,138,.35)"
              },
              {
                "box-shadow": "0 6px 0 #120b1e, 0 10px 18px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.22)"
              },
              {
                "padding": "10px 12px"
              },
              {
                "margin-bottom": "10px"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i n\" \"i l\""
              },
              {
                "grid-template-columns": "54px 1fr"
              },
              {
                "grid-template-rows": "min-content min-content"
              }
            ],
            "img_cell": [
              {
                "width": "44px"
              },
              {
                "height": "44px"
              },
              {
                "border-radius": "50%"
              },
              {
                "background": "[[[ return `radial-gradient(circle at 35% 30%, ${variables.c1} 0%, ${variables.c2} 65%)` ]]]"
              },
              {
                "box-shadow": "[[[ return `0 3px 0 ${variables.c3}, inset 0 2px 2px rgba(255,255,255,.35), inset 0 -2px 3px rgba(0,0,0,.3)` ]]]"
              }
            ],
            "icon": [
              {
                "width": "22px"
              },
              {
                "color": "#fff"
              },
              {
                "filter": "drop-shadow(0 1px 1px rgba(0,0,0,.5))"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-weight": "600"
              },
              {
                "font-size": "15px"
              },
              {
                "color": "#fff"
              },
              {
                "white-space": "normal"
              },
              {
                "text-align": "left"
              }
            ],
            "label": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "12px"
              },
              {
                "color": "#d9c4f0"
              },
              {
                "white-space": "normal"
              },
              {
                "text-align": "left"
              }
            ]
          }
        },
        "cc_title": {
          "show_label": true,
          "tap_action": {
            "action": "none"
          },
          "variables": {
            "lights": []
          },
          "label": "[[[ const L=variables.lights||[]; if(!L.length) return variables.sub||\"\"; const n=L.filter(e=>states[e]&&states[e].state===\"on\").length; return (variables.sub?variables.sub+\" · \":\"\")+(n?`💡 ${n} allumée${n>1?\"s\":\"\"}`:\"Tout est éteint\") ]]]",
          "styles": {
            "card": [
              {
                "background": "rgba(25,18,38,.72)"
              },
              {
                "backdrop-filter": "blur(16px)"
              },
              {
                "border-radius": "14px"
              },
              {
                "border": "none"
              },
              {
                "border-bottom": "2px solid rgba(246,214,138,.55)"
              },
              {
                "box-shadow": "none"
              },
              {
                "padding": "10px 14px"
              },
              {
                "cursor": "default"
              },
              {
                "margin-top": "10px"
              },
              {
                "margin-bottom": "4px"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i n\" \"i l\""
              },
              {
                "grid-template-columns": "40px 1fr"
              }
            ],
            "icon": [
              {
                "width": "26px"
              },
              {
                "color": "#f6d68a"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-weight": "700"
              },
              {
                "font-size": "17px"
              },
              {
                "color": "#f6d68a"
              },
              {
                "text-shadow": "0 1px 3px rgba(0,0,0,.9)"
              }
            ],
            "label": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "12px"
              },
              {
                "color": "#d9c4f0"
              }
            ]
          }
        },
        "cc_chip": {
          "template": "cc_card",
          "show_label": true,
          "tap_action": {
            "action": "more-info"
          },
          "styles": {
            "card": [
              {
                "padding": "8px 10px"
              },
              {
                "border": "1px solid rgba(246,214,138,.22)"
              },
              {
                "box-shadow": "0 4px 0 rgba(12,8,22,.75)"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i n\" \"i l\""
              },
              {
                "grid-template-columns": "34px 1fr"
              }
            ],
            "icon": [
              {
                "width": "22px"
              },
              {
                "color": "#f6d68a"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-weight": "700"
              },
              {
                "font-size": "16px"
