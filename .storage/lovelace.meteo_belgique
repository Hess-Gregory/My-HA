                  "secondary": "{% set c = states(entity) | replace('-', ' ') | title %}\n{% set app = state_attr(entity, 'apparent_temperature') %}\n{% set app_str = (app | round(0)) ~ '°' if app is numeric else '--' %}\n{% set fc = state_attr(entity, 'forecast') %}\n{% set hi = fc[0].temperature if fc and fc[0] is defined and fc[0].temperature is numeric else none %}\n{% set lo = fc[0].templow if fc and fc[0] is defined and fc[0].templow is numeric else none %}\n{% set range_str = ' · ↑' ~ (hi | round(0)) ~ '° / ↓' ~ (lo | round(0)) ~ '°' if hi is not none and lo is not none else '' %}\n{{ c }} · Ressenti {{ app_str }}{{ range_str }}",
