                    "hero": "[[[\n  const d=new Date(), hr=d.getHours();\n  const g=hr<5?'Bonne nuit':hr<12?'Bonjour':hr<18?'Bon après-midi':'Bonsoir';\n  const who=(user&&user.name)||'';\n  const date=d.toLocaleDateString('fr-BE',{weekday:'long',day:'numeric',month:'long'});\n  const w=states['weather.forecast_maison']; const WF={'clear-night':['🌙','Nuit claire'],cloudy:['☁️','Nuageux'],fog:['🌫️','Brouillard'],hail:['🌨️','Grêle'],lightning:['⚡','Orage'],'lightning-rainy':['⛈️','Orage'],partlycloudy:['⛅','Éclaircies'],pouring:['🌧️','Averses'],rainy:['🌦️','Pluie'],snowy:['❄️','Neige'],sunny:['☀️','Ensoleillé'],windy:['💨','Venteux']};\n  const wf=w?(WF[w.state]||['🌡️',w.state]):['',''];\n  const tin=Number(states['sensor.temp_piece_de_vie_sonoff_a480146b56_temperature']?.state);\n  const home=['person.greg','person.sandrine'].filter(p=>states[p]?.state==='home').length;\n  const al=states['alarm_control_panel.buanderie_local_tech_centrale_alarme_ajax']?.state||''; const alarm=al.startsWith('armed')?['🛡️','Alarme armée','#7fdc9a']:al==='triggered'?['🚨','Alarme déclenchée','#f07a7a']:['🔓','Alarme désarmée','#d9c4f0'];\n  let an=''; const L=states['sensor.anniversaires']?.attributes?.liste||[]; const t0=new Date(d.getFullYear(),d.getMonth(),d.getDate());\n  const nx=L.map(x=>{const [y,mo,da]=x.date.split('-').map(Number); let p=new Date(d.getFullYear(),mo-1,da); if(p<t0) p=new Date(d.getFullYear()+1,mo-1,da); return {j:Math.round((p-t0)/864e5),n:x.nom,ty:x.type}}).sort((a,b)=>a.j-b.j)[0];\n  if(nx) an=(nx.ty==='memoire'?'🕊️':nx.ty==='rencontre'?'💞':'🎂')+' '+nx.n+(nx.j===0?\" aujourd'hui\":' dans '+nx.j+' j');\n  const pill=(t,col)=>`<span style=\"display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(246,214,138,.25);font-size:13px;color:${col||'#fff'};white-space:nowrap\">${t}</span>`;\n  return `<div style=\"text-align:left;padding:6px 4px\">\n   <div style=\"font:700 28px sans-serif;color:#f6d68a;text-shadow:0 2px 8px rgba(0,0,0,.8)\">${g}${who?', '+who:''}</div>\n   <div style=\"font-size:14px;color:#d9c4f0;margin:2px 0 12px;\"><span style=\"text-transform:capitalize\">${date}</span> · 🤖 Sam veille sur la maison</div>\n   <div style=\"display:flex;flex-wrap:wrap;gap:8px\">\n    ${w?pill(wf[0]+' '+Number(w.attributes.temperature).toFixed(0)+'° dehors · '+wf[1]):''}\n    ${!isNaN(tin)?pill('🛋️ '+tin.toFixed(1)+'° au salon'):''}\n    ${pill('🏠 '+(home?home+' à la maison':'Personne à la maison'))}\n    ${pill(alarm[0]+' '+alarm[1],alarm[2])}\n    ${an?pill(an):''}\n   </div></div>` ]]]"
