              {
                "font-size": "12px"
              },
              {
                "font-weight": "600"
              },
              {
                "color": "[[[ return states[variables.ent]?.state===variables.opt?\"#2a1d44\":\"#fff\" ]]]"
              }
            ]
          }
        }
      }
    }
  }
}