                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.boiler_servicecodenumber",
                  "primary": "Code service EMS-ESP",
                  "secondary": "{% set services = {200:'-H',201:'=H',202:'0A',203:'0H',204:'0Y',207:'2E',208:'-A',214:'',224:'',260:'2F',265:'0E',270:'0U',276:'0Y',283:'0C',284:'0L',285:'0Y',306:'FA'} %} {% set n = states(entity) | int(0) %} {{ services.get(n, '?') }} · n° {{ n }}",
                  "icon": "mdi:information-outline",
                  "icon_color": "{% set n = states(entity) | int(0) %} {{ 'green' if n in [200,201,203,204,208,265,270,283,284] else 'amber' }}",
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n\n.container.fixed-height { height: auto !important; min-height: 56px !important; }\n.content.fixed-info-height { height: auto !important; }\nha-tile-info span { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                  },
                  "grid_options": {
                    "rows": 1,
                    "columns": 12
                  }
                },
                {
                  "type": "markdown",
                  "content": "{% set n = states('sensor.boiler_servicecodenumber') | int(0) %} {% set services = {\n  200: ('-H', 'Chaudière en fonctionnement chauffage', 'Fonctionnement normal. Aucune action requise.'),\n  201: ('=H', 'Chaudière en fonctionnement Eau Chaude Sanitaire', 'Fonctionnement normal. Aucune action requise.'),\n  202: ('0A', 'Optimisation du redémarrage / Temporisation brûleur', 'Fonctionnement normal. La chaudière attend la fin de la temporisation pour redémarrer.'),\n  203: ('0H', 'Chaudière en veille (pas de demande de chaleur)', 'Fonctionnement normal. Aucune action requise.'),\n  204: ('0Y', 'Température de départ supérieure à la consigne', 'Fonctionnement normal. Attendre la baisse de température du circuit.'),\n  207: ('2E', 'Pression d eau chauffage trop basse (< 0.8 bar)', 'Procédure : Ouvrir les robinets de remplissage sous la chaudière jusqu à atteindre 1.5 bar puis bien refermer.'),\n  208: ('-A', 'Mode ramoneur / test de combustion actif', 'Test en cours. S éteint automatiquement après 15 minutes.'),\n  214: ('', 'Ventilateur arrêté en phase de sécurité', 'Attendre le redémarrage automatique. Si répétitif, faire vérifier par le chauffagiste.'),\n  224: ('', 'Limiteur de sécurité déclenché temporairement', 'Attendre le refroidissement. Si la chaudière se bloque sur E9, appliquer la procédure E9.'),\n  260: ('2F', 'Écart de température anormal entre départ et retour', 'Purger les radiateurs et vérifier que les vannes du circuit sont ouvertes.'),\n  265: ('0E', 'Demande de chaleur inférieure à la puissance minimale', 'Fonctionnement normal en modulation basse. Aucune action requise.'),\n  270: ('0U', 'Chaudière en phase de pré-démarrage', 'Fonctionnement normal. Attendre l allumage.'),\n  276: ('0Y', 'Température départ mesurée très élevée', 'Attendre la circulation de l eau. Si persistant, vérifier la pompe de circulation.'),\n  283: ('0C', 'Préparation du brûleur à l allumage', 'Fonctionnement normal. Attendre l allumage.'),\n  284: ('0L', 'Ouverture du bloc gaz', 'Fonctionnement normal pendant la phase d allumage.'),\n  285: ('0Y', 'Surchauffe interne temporaire', 'Attendre le refroidissement complet du corps de chauffe.'),\n  306: ('FA', 'Flamme résiduelle après coupure gaz', 'Défaut de sécurité. Si la chaudière se bloque, appeler le chauffagiste.')\n} %} **{{ services[n][0] if n in services else '?' }} (N° {{ n }})** — {% if n in services %}{{ services[n][1] }}. 👉 **Que faire :** {{ services[n][2] }}{% else %}Code non répertorié. Si la chaudière fonctionne correctement, aucune action n est requise.{% endif %}",
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n"
                  }
                }
              ]
