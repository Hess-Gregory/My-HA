        "image": "/local/images/wallpaper/mon-confort.jpg",
        "size": "cover",
        "attachment": "fixed"
      },
      "views": [
        {
          "title": "Vue d'Ensemble",
          "path": "vue-ensemble",
          "icon": "mdi:view-dashboard",
          "type": "sections",
          "max_columns": 4,
          "header": {
            "card": {
              "type": "markdown",
              "content": "# 🌡️ Mon Confort › Vue d'Ensemble\nChauffage · climatisation · humidité · chaudière",
              "text_only": true,
              "card_mod": {
                "style": "ha-card { background: rgba(25, 18, 38, 0.72) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; box-shadow: none !important; padding: 12px 20px !important; } ha-markdown { text-align: center !important; text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,1) !important; color: #f6d68a !important; }\n"
              }
            }
          },
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Résumé rapide",
                  "icon": "mdi:label-outline",
                  "variables": {
                    "sub": "",
                    "lights": []
                  },
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
