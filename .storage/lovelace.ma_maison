                            "styles": ":host {\n  width: 140px;\n  margin: 2px auto 4px;\n}\n.circlepad {\n  background: radial-gradient(circle at 35% 30%, #3a3350 0%, #170f22 72%);\n  border: 2px solid rgba(246, 214, 138, 0.25);\n  border-radius: 50%;\n  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.6), inset 0 2px 4px rgba(255, 255, 255, 0.08);\n}\n#up, #down, #left, #right {\n  --icon-color: #cfc4e3;\n  --icon-size: 18px;\n}\n#center::part(button) {\n  background: radial-gradient(circle at 35% 30%, #f6d68a 0%, #b98f3f 100%);\n  border-radius: 50%;\n  width: 46px;\n  height: 46px;\n  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.5), inset 0 1px 2px rgba(255, 255, 255, 0.3);\n}\n#center {\n  --icon-color: #241a33;\n}\n#center .label {\n  color: #241a33;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  font-family: inherit;\n}"
