                            "custom_fields": {
                              "v": "[[[ const v=(()=>{const b=states['input_number.four_temp_voulue'];const ok=!isNaN(Number(entity.state));return (!ok||(b&&new Date(b.last_changed)>new Date(entity.last_changed)))?Number(b?.state):Number(entity.state)})(); return `${Math.round(v)}<span style='font-size:15px;color:#d9c4f0'> °C</span>` ]]]",
