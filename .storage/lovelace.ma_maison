                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Carnet de cuisson",
                  "icon": "mdi:notebook-outline",
                  "variables": {
                    "sub": "Chaque cuisson est notée automatiquement · statistiques de la semaine",
                    "lights": []
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
