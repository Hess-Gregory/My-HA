                      ],
                      "custom_fields": {
                        "hd": "[[[ const mode=states['input_select.mode_salle_de_bain']?.state||''; const cs=states['sensor.consigne_salle_de_bain']?.state; const heat=states['binary_sensor.salle_de_bain_demande_de_chaleur']?.state==='on'; const ext=states['weather.forecast_maison']?.attributes?.temperature;\n  const pill=(x,col)=>`<span style=\"padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(246,214,138,.25);font-size:13px;color:${col||'#fff'};white-space:nowrap\">${x}</span>`;\n  return `<div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:8px;justify-content:space-between\">\n   <div style=\"text-align:left\"><div style=\"font:700 20px sans-serif;color:#f6d68a\">Mode ${mode}</div><div style=\"font-size:13px;color:#d9c4f0\">${cs==='off'?'Chauffage coupé':'Objectif '+cs+' °C'} · aiguille dorée = objectif</div></div>\n   <div style=\"display:flex;gap:6px;flex-wrap:wrap\">${pill(heat?'🔥 Chauffe':'● En attente',heat?'#f3a156':'#9d8fb3')}${ext!=null?pill('🌳 Dehors '+Number(ext).toFixed(1)+' °C'):''}</div></div>` ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "transparent"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "box-shadow": "none"
                          },
                          {
                            "padding": "14px 16px 0"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"hd\""
                          }
                        ],
                        "custom_fields": {
                          "hd": [
                            {
                              "justify-self": "stretch"
                            }
                          ]
                        }
                      }
