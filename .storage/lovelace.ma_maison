                      "tap_action": {
                        "action": "more-info",
                        "entity": "media_player.ampli_cine"
                      },
                      "triggers_update": [
                        "media_player.ampli_cine"
                      ],
                      "custom_fields": {
                        "lcd": "[[[ function lcdBox(l1,l2,tag){return `<div style=\"background:linear-gradient(180deg,#0c1216,#141c20);border-radius:12px;padding:8px 12px;box-shadow:inset 0 2px 6px rgba(0,0,0,.8),0 1px 0 ${false?'rgba(255,255,255,.9)':'rgba(255,255,255,.06)'};text-align:left;font-family:ui-monospace,Menlo,Consolas,monospace;position:relative\"><div style=\"color:#f6d68a;font-size:15px;font-weight:700;letter-spacing:1.5px;text-shadow:0 0 6px rgba(246,214,138,.7);white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">${l1}</div><div style=\"color:#cdbf97;font-size:11px;letter-spacing:1px;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">${l2}</div>${tag?`<div style=\"position:absolute;right:10px;top:8px;font-size:10px;color:#0c1216;background:#f6d68a;border-radius:4px;padding:1px 4px\">${tag}</div>`:''}</div>`}  const s=states['media_player.ampli_cine']; if(!s) return ''; const on=!['off','unavailable','standby'].includes(s.state); const v=s.attributes.volume_level; const m=s.attributes.is_volume_muted; const sm=(s.attributes.sound_mode||'').replace(/_/g,' ');\n   return lcdBox(on?(s.attributes.source||'AMPLI'):'VEILLE', on?(m?'🔇 MUET':'VOL '+(v!=null?Math.round(v*100):'--'))+(sm?' · '+sm.toUpperCase():''):'○ Ampli éteint','') ]]]"
                      },
                      "styles": {
                        "card": [
