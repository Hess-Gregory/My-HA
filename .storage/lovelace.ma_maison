                  ]
                },
                {
                  "type": "custom:button-card",
                  "entity": "sensor.four_carnet",
                  "show_icon": false,
                  "show_name": false,
                  "tap_action": {
                    "action": "none"
                  },
                  "triggers_update": [
                    "sensor.four_carnet",
                    "counter.four_cuissons_nettoyage"
                  ],
                  "custom_fields": {
                    "c": "[[[ const P={\"steam_modes_steam\":\"Vapeur\",\"heating_mode_hot_air\":\"Chaleur tournante\",\"heating_mode_top_bottom_heating\":\"Voûte / sole\",\"heating_mode_top_bottom_heating_eco\":\"Voûte/sole éco\",\"heating_mode_hot_air_grilling\":\"Gril air pulsé\",\"heating_mode_pizza_setting\":\"Pizza\",\"heating_mode_frozen_heatup_special\":\"Surgelés\",\"heating_mode_slow_cook\":\"Cuisson lente\",\"heating_mode_bottom_heating\":\"Sole\",\"heating_mode_keep_warm\":\"Maintien au chaud\",\"heating_mode_preheat_ovenware\":\"Chauffe-plats\",\"heating_mode_pre_heating\":\"Préchauffage\"}; let L=entity.attributes.liste||[]; if(typeof L==='string'){try{L=JSON.parse(L.replace(/'/g,'\"'))}catch(e){L=[]}}\n  const now=new Date(); const wk=L.filter(x=>(now-new Date(x.d))<7*864e5); const mins=wk.reduce((a,x)=>a+Number(x.m||0),0);\n  const cnt={}; L.forEach(x=>{const k=x.n||P[x.p]||'Réglé sur le four';cnt[k]=(cnt[k]||0)+1}); const top=Object.entries(cnt).sort((a,b)=>b[1]-a[1])[0];\n  const net=states['counter.four_cuissons_nettoyage']?.state;\n  const kpi=(t,v)=>`<div style=\"flex:1;min-width:110px;background:#111116;border:1px solid #25252d;border-radius:12px;padding:8px 10px\"><div style=\"font-size:10px;letter-spacing:2px;color:#8a8a96\">${t}</div><div style=\"font-family:ui-monospace,Menlo,Consolas,monospace;font-size:18px;color:#fff\">${v}</div></div>`;\n  const rows=L.slice(-8).reverse().map(x=>{const d=new Date(x.d);return `<div style=\"display:grid;grid-template-columns:110px 1fr auto;gap:10px;padding:7px 0;border-top:1px solid #1f1f27;font-size:13px\"><span style=\"font-family:ui-monospace,Menlo,Consolas,monospace;color:#8a8a96\">${d.toLocaleDateString('fr-BE',{weekday:'short',day:'2-digit',month:'2-digit'})} ${d.toLocaleTimeString('fr-BE',{hour:'2-digit',minute:'2-digit'})}</span><span style=\"color:#e8e8ee;text-align:left\">${x.n||'<span style=color:#8a8a96>Réglé sur le four</span>'}${x.p?' <span style=\"color:#ff9d2e\">· '+(P[x.p]||'')+'</span>':''}</span><span style=\"font-family:ui-monospace,Menlo,Consolas,monospace;color:#c9c9d3\">${x.m} min · ${x.t}°</span></div>`}).join('');\n  return `<div style=\"text-align:left\"><div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px\">${kpi('CETTE SEMAINE',wk.length+' cuisson'+(wk.length>1?'s':''))}${kpi('TEMPS DE FOUR',Math.floor(mins/60)+' h '+String(mins%60).padStart(2,'0'))}${kpi('LE PLUS CUISINÉ',top?top[0]:'—')}${kpi('DEPUIS NETTOYAGE',(net&&net!=='unavailable'?net:'—')+' cuissons')}</div>${rows||'<div style=\"color:#8a8a96;padding:8px 0\">Les prochaines cuissons s’afficheront ici automatiquement.</div>'}</div>` ]]]"
                  },
                  "extra_styles": "#container{white-space:normal!important}",
                  "styles": {
