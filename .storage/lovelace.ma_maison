            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Cave — Sécurité",
                  "icon": "mdi:label-outline",
                  "variables": {
                    "sub": "Zone Ajax \"coffre-fort\"",
                    "lights": []
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:mushroom-alarm-control-panel-card",
                  "entity": "alarm_control_panel.buanderie_centrale_alarme_ajax_cave",
                  "name": "Alarme Cave",
                  "icon": "mdi:home-import-outline",
                  "layout": "horizontal",
                  "states": [
                    "armed_home",
                    "disarmed"
                  ],
                  "primary_info": "state",
                  "secondary_info": "last-changed",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": {
                      ".": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n",
                      "mushroom-state-info": {
                        "$": ".secondary, .primary { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                      }
                    }
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "layout": "vertical",
                  "entity": "binary_sensor.cave_sous_sol_cave_porte",
                  "primary": "Porte Cave",
                  "secondary": "{{ 'Ouverte' if is_state(entity, 'on') else 'Fermée' }}",
                  "icon": "{{ 'mdi:door-open' if is_state(entity, 'on') else 'mdi:door-closed' }}",
                  "icon_color": "{{ 'orange' if is_state(entity, 'on') else 'green' }}",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n\n.container.fixed-height { height: auto !important; min-height: 56px !important; }\n.content.fixed-info-height { height: auto !important; }\nha-tile-info span { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "layout": "vertical",
                  "entity": "sensor.cave_sous_sol_cave_temperature",
                  "primary": "Température Cave",
                  "secondary": "{{ states(entity) | float(0) | round(1) }} °C",
                  "icon": "mdi:thermometer",
                  "icon_color": "amber",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n\n.container.fixed-height { height: auto !important; min-height: 56px !important; }\n.content.fixed-info-height { height: auto !important; }\nha-tile-info span { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "layout": "vertical",
                  "entity": "binary_sensor.cave_sous_sol_incendie_cave_fumee",
                  "primary": "Détecteur incendie cave",
                  "secondary": "{% if is_state('binary_sensor.cave_sous_sol_incendie_cave_fumee','on') %}🔥 Alerte fumée{% elif is_state('binary_sensor.cave_sous_sol_incendie_cave_chaleur','on') %}🌡️ Alerte chaleur{% elif is_state('binary_sensor.cave_sous_sol_incendie_cave_sabotage_du_boitier','on') %}⚠️ Sabotage{% else %}RAS · {{ states('sensor.cave_sous_sol_incendie_cave_temperature') }} °C · 🔋 {{ states('sensor.cave_sous_sol_incendie_cave_batterie') }} %{% endif %}",
                  "icon": "mdi:fire-alert",
                  "icon_color": "{{ 'red' if is_state('binary_sensor.cave_sous_sol_incendie_cave_fumee','on') or is_state('binary_sensor.cave_sous_sol_incendie_cave_chaleur','on') else 'green' }}",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n\n.container.fixed-height { height: auto !important; min-height: 56px !important; }\n.content.fixed-info-height { height: auto !important; }\nha-tile-info span { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "markdown",
                  "content": "<!-- versioning-footer -->\n<div style=\"text-align:center;font-size:0.72em;opacity:0.55;line-height:1.7;margin-top:10px;padding-top:8px;border-top:1px solid var(--divider-color);\">\n🔧 <b>1_ma_maison</b> &middot; v{{ state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison').version if state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison') else 'non versionne' }}<br>\n📦 <b>chaudiere</b> &middot; v{{ state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml').version if state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml') else 'non versionne' }}<br>\n📦 <b>chauffage</b> &middot; v{{ state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml').version if state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml') else 'non versionne' }}<br>\nConçu et maintenu par <b>Gregory</b> via Claude AI\n</div>",
                  "grid_options": {
                    "columns": 36,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\n"
                  }
                }
              ],
              "column_span": 4
            }
          ],
          "show_icon_and_title": true
        },
        {
          "title": "Pièce de Vie",
          "path": "piece-de-vie",
          "type": "sections",
          "max_columns": 3,
          "background": {
            "image": "/local/images/wallpaper/ma-maison.jpg",
            "size": "cover",
            "attachment": "fixed"
          },
          "sections": [
            {
              "type": "grid",
              "column_span": 3,
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Pièce de vie",
                  "icon": "mdi:sofa",
                  "variables": {
                    "sub": "Salon · salle à manger · cuisine · coin DJ",
                    "lights": [
                      "light.lustre_salon",
                      "light.salon_panneau_mural",
                      "light.salon_ambilight_tv",
                      "light.lumieres_sono",
                      "light.coin_dj_sono_gauche",
                      "light.coin_dj_sono_droite",
                      "light.lustre_salle_a_manger",
                      "light.vitrine",
                      "light.cuisine_cuisine",
                      "light.spot_cuisine",
                      "light.cuisine_etagere_cafe",
                      "light.evier"
                    ]
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_chip",
                  "entity": "sensor.temp_piece_de_vie_sonoff_a480146b56_temperature",
                  "name": "[[[ return Number(entity.state).toFixed(1)+\" °C\" ]]]",
                  "label": "Température",
                  "icon": "mdi:thermometer",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_chip",
                  "entity": "sensor.temp_piece_de_vie_sonoff_a480146b56_humidity",
                  "name": "[[[ return Math.round(entity.state)+\" %\" ]]]",
                  "label": "Humidité",
                  "icon": "mdi:water-percent",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_chip",
                  "entity": "input_select.mode_piece_de_vie",
                  "name": "[[[ return entity.state ]]]",
                  "label": "Mode chauffage",
                  "icon": "mdi:radiator",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_chip",
                  "entity": null,
                  "name": "[[[ const L=[\"light.lustre_salon\",\"light.salon_panneau_mural\",\"light.salon_ambilight_tv\",\"light.lumieres_sono\",\"light.coin_dj_sono_gauche\",\"light.coin_dj_sono_droite\",\"light.lustre_salle_a_manger\",\"light.vitrine\",\"light.cuisine_cuisine\",\"light.spot_cuisine\",\"light.cuisine_etagere_cafe\",\"light.evier\"]; return L.filter(e=>states[e]&&states[e].state===\"on\").length+\" / \"+L.length ]]]",
                  "label": "Lumières allumées",
                  "icon": "mdi:lightbulb-group",
                  "tap_action": {
                    "action": "none"
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_chip",
                  "entity": "switch.sono_dj",
                  "name": "[[[ return entity.state===\"on\"?\"En marche\":\"Arrêtée\" ]]]",
                  "label": "Sono DJ",
                  "icon": "mdi:speaker",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_chip",
                  "entity": "media_player.ampli_cine",
                  "name": "[[[ return {playing:\"Lecture\",paused:\"Pause\",on:\"Allumé\",off:\"Éteint\",idle:\"Veille\"}[entity.state]||entity.state ]]]",
                  "label": "Ampli ciné",
                  "icon": "mdi:amplifier",
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_push",
                  "name": "Tout éteindre",
                  "label": "Toutes les lumières de la pièce",
                  "icon": "mdi:lightbulb-off-outline",
                  "tap_action": {
                    "action": "call-service",
                    "service": "light.turn_off",
                    "target": {
                      "entity_id": [
                        "light.lustre_salon",
                        "light.salon_panneau_mural",
                        "light.salon_ambilight_tv",
                        "light.lumieres_sono",
                        "light.coin_dj_sono_gauche",
                        "light.coin_dj_sono_droite",
                        "light.lustre_salle_a_manger",
                        "light.vitrine",
                        "light.cuisine_cuisine",
                        "light.spot_cuisine",
                        "light.cuisine_etagere_cafe",
                        "light.evier"
                      ]
                    },
                    "haptic": "medium"
                  },
                  "variables": {
                    "c1": "#f07a7a",
                    "c2": "#b33636",
                    "c3": "#6e1f1f"
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_push",
                  "name": "Ambiance ciné",
                  "label": "Ampli · scène 3",
                  "icon": "mdi:movie-open-outline",
                  "tap_action": {
                    "action": "call-service",
                    "service": "media_player.play_media",
                    "target": {
                      "entity_id": "media_player.ampli_cine"
                    },
                    "data": {
                      "media_content_type": "scene",
                      "media_content_id": "3"
                    },
                    "haptic": "medium"
                  },
                  "variables": {
                    "c1": "#9b78e0",
                    "c2": "#5b3f99",
                    "c3": "#3a2766"
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:button-card",
                  "template": "cc_push",
                  "name": "Clim",
