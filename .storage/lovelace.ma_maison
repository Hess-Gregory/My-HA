            {
              "type": "grid",
              "cards": [
                {
                  "type": "markdown",
                  "content": "<!-- versioning-footer -->\n<div style=\"text-align:center;font-size:0.72em;opacity:0.55;line-height:1.7;margin-top:10px;padding-top:8px;border-top:1px solid var(--divider-color);\">\n🔧 <b>1_ma_maison</b> &middot; v{{ state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison').version if state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison') else 'non versionne' }}<br>\n📦 <b>chaudiere</b> &middot; v{{ state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml').version if state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml') else 'non versionne' }}<br>\n📦 <b>chauffage</b> &middot; v{{ state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml').version if state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml') else 'non versionne' }}<br>\nConçu et maintenu par <b>Gregory</b> via Claude AI\n</div>",
                  "grid_options": {
                    "columns": 36,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\n"
                  }
                }
              ],
              "column_span": 4
            }
          ],
          "show_icon_and_title": true
