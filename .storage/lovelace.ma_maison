                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card { background: rgba(38, 28, 58, 0.55) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: none !important; box-shadow: none !important; }\n\n.container.fixed-height { height: auto !important; min-height: 56px !important; }\n.content.fixed-info-height { height: auto !important; }\nha-tile-info span { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "markdown",
                  "content": "<!-- versioning-footer -->\n<div style=\"text-align:center;font-size:0.72em;opacity:0.55;line-height:1.7;margin-top:10px;padding-top:8px;border-top:1px solid var(--divider-color);\">\n🔧 <b>1_ma_maison</b> &middot; v{{ state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison').version if state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', '.storage/lovelace.1_ma_maison') else 'non versionne' }}<br>\n📦 <b>chaudiere</b> &middot; v{{ state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml').version if state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', 'packages/chaudiere.yaml') else 'non versionne' }}<br>\n📦 <b>chauffage</b> &middot; v{{ state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml').version if state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml') else '0.0.0' }} &middot; {{ as_timestamp(state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml').last_update) | timestamp_custom('%d/%m/%Y a %H:%M') if state_attr('sensor.versions_config_ha', 'packages/chauffage.yaml') else 'non versionne' }}<br>\nConçu et maintenu par <b>Gregory</b> via Claude AI\n</div>",
                  "grid_options": {
                    "columns": 36,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\n"
                  }
                }
              ],
              "column_span": 4
            }
          ],
          "show_icon_and_title": true
        }
      ],
      "button_card_templates": {
        "cc_card": {
          "styles": {
            "card": [
              {
                "background": "rgba(38,28,58,.55)"
              },
              {
                "backdrop-filter": "blur(16px)"
              },
              {
                "-webkit-backdrop-filter": "blur(16px)"
              },
              {
                "border-radius": "16px"
              },
              {
                "padding": "10px 12px"
              },
              {
                "border": "[[[ const on=(entity && ['on','playing'].includes(entity.state)); const c=(entity && entity.attributes && entity.attributes.rgb_color); return on?(c?`1px solid rgba(${c},.75)`:'1px solid rgba(246,214,138,.8)'):'1px solid rgba(246,214,138,.22)' ]]]"
              },
              {
                "box-shadow": "[[[ const on=(entity && ['on','playing'].includes(entity.state)); const c=(entity && entity.attributes && entity.attributes.rgb_color); return on?(c?`0 0 16px rgba(${c},.35), 0 4px 0 rgba(12,8,22,.75)`:'0 0 14px rgba(246,214,138,.3), 0 4px 0 rgba(12,8,22,.75)'):'0 4px 0 rgba(12,8,22,.75)' ]]]"
              },
              {
                "margin-bottom": "6px"
              }
            ]
          }
        },
        "cc_switch": {
          "template": "cc_card",
          "show_label": true,
          "show_state": false,
          "tap_action": {
            "action": "toggle",
            "haptic": "light"
          },
          "hold_action": {
            "action": "more-info"
          },
          "extra_styles": "ha-card{transition:transform .08s,box-shadow .08s} ha-card:active{transform:translateY(4px)}",
          "label": "[[[ if(!entity) return ''; if(entity.state==='unavailable') return 'Indisponible'; const on=entity.state==='on'; let t=on?'Allumé':'Éteint'; if(on && entity.attributes.brightness!=null) t+=' · '+Math.round(entity.attributes.brightness/2.55)+' %'; return t ]]]",
          "custom_fields": {
            "sw": "[[[ const on=(entity && ['on','playing'].includes(entity.state)); const c=(entity && entity.attributes && entity.attributes.rgb_color); const col=c?`rgb(${c})`:'linear-gradient(180deg,#f6d68a,#d4a23c)'; return `<div style=\"width:54px;height:30px;border-radius:15px;background:${on?col:'rgba(255,255,255,.12)'};box-shadow:inset 0 2px 5px rgba(0,0,0,.5);position:relative\"><div style=\"position:absolute;top:3px;left:${on?27:3}px;width:24px;height:24px;border-radius:50%;background:linear-gradient(180deg,#fff,#cfcfcf);box-shadow:0 2px 4px rgba(0,0,0,.55)\"></div></div>` ]]]"
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i n sw\" \"i l sw\""
              },
              {
                "grid-template-columns": "50px 1fr 60px"
              },
              {
                "grid-template-rows": "min-content min-content"
              }
            ],
            "img_cell": [
              {
                "width": "42px"
              },
              {
                "height": "42px"
              },
              {
                "border-radius": "50%"
              },
              {
                "background": "[[[ const on=(entity && ['on','playing'].includes(entity.state)); const c=(entity && entity.attributes && entity.attributes.rgb_color); return on?(c?`rgb(${c})`:'linear-gradient(145deg,#f6d68a,#d4a23c)'):'rgba(255,255,255,.08)' ]]]"
              },
              {
                "box-shadow": "[[[ const on=(entity && ['on','playing'].includes(entity.state)); const c=(entity && entity.attributes && entity.attributes.rgb_color); return on?(c?`0 0 12px rgb(${c})`:'0 0 12px rgba(246,214,138,.5)'):'none' ]]]"
              }
            ],
            "icon": [
              {
                "width": "22px"
              },
              {
                "color": "[[[ const on=(entity && ['on','playing'].includes(entity.state)); return on?((entity && entity.attributes && entity.attributes.rgb_color)?'#fff':'#3a2766'):'#bfb2d6' ]]]"
              },
              {
                "filter": "drop-shadow(0 1px 1px rgba(0,0,0,.5))"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-weight": "600"
              },
              {
                "font-size": "15px"
              },
              {
                "color": "#fff"
              },
              {
                "white-space": "normal"
              },
              {
                "text-align": "left"
              }
            ],
            "label": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "12px"
              },
              {
                "font-weight": "600"
              },
              {
                "color": "[[[ return (entity && ['on','playing'].includes(entity.state))?'#f6d68a':'#9d8fb3' ]]]"
              }
            ],
            "custom_fields": {
              "sw": [
                {
                  "justify-self": "end"
                }
              ]
            }
          }
        },
        "cc_light_inner": {
          "template": "cc_switch",
          "styles": {
