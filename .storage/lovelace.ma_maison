                      },
                      "triggers_update": [
                        "media_player.orange_tv_box",
                        "input_boolean.telecommande_pave_numerique"
                      ],
                      "custom_fields": {
                        "lcd": "[[[ function lcdBox(l1,l2,tag){return `<div style=\"background:linear-gradient(180deg,#0c1216,#141c20);border-radius:12px;padding:8px 12px;box-shadow:inset 0 2px 6px rgba(0,0,0,.8),0 1px 0 ${true?'rgba(255,255,255,.9)':'rgba(255,255,255,.06)'};text-align:left;font-family:ui-monospace,Menlo,Consolas,monospace;position:relative\"><div style=\"color:#f6d68a;font-size:15px;font-weight:700;letter-spacing:1.5px;text-shadow:0 0 6px rgba(246,214,138,.7);white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">${l1}</div><div style=\"color:#cdbf97;font-size:11px;letter-spacing:1px;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">${l2}</div>${tag?`<div style=\"position:absolute;right:10px;top:8px;font-size:10px;color:#0c1216;background:#f6d68a;border-radius:4px;padding:1px 4px\">${tag}</div>`:''}</div>`}  const s=states['media_player.orange_tv_box']; if(!s) return ''; const on=s.state!=='off'&&s.state!=='unavailable'; const A={'com.orange.be.nexx4.tv.android':'TV ORANGE','com.netflix.ninja':'NETFLIX','com.google.android.youtube.tv':'YOUTUBE'}; const app=A[s.attributes.app_id]||(s.attributes.app_name||'').split('.').pop().toUpperCase(); const pv=states['input_boolean.telecommande_pave_numerique']?.state==='on';\n   return lcdBox(on?app||'EN MARCHE':'VEILLE', on?'● Box allumée':'○ Box éteinte', pv?'123':'') ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "linear-gradient(180deg, #ffffff 0%, #f8f8fb 100%)"
                          },
                          {
                            "border-radius": "34px 34px 0 0"
                          },
                          {
                            "padding": "18px 18px 6px"
                          },
                          {
                            "border": "1px solid rgba(255,255,255,.8)"
                          },
                          {
                            "border-bottom": "none"
                          },
                          {
                            "box-shadow": "inset 0 3px 4px rgba(255,255,255,1)"
                          },
