                      },
                      "card_mod": {
                        "style": "ha-card{background:transparent!important;border:none!important;box-shadow:none!important;{% if is_state('light.evier','on') %}padding:0 12px 10px!important;{% else %}padding:0!important;height:0!important;overflow:hidden;{% endif %}}"
                      }
