          "styles": {
            "card": [
              {
                "padding": "8px 10px"
              },
              {
                "border": "1px solid rgba(246,214,138,.22)"
              },
              {
                "box-shadow": "0 4px 0 rgba(12,8,22,.75)"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i n\" \"i l\""
              },
              {
                "grid-template-columns": "34px 1fr"
              }
            ],
            "icon": [
              {
                "width": "22px"
              },
              {
                "color": "#f6d68a"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-weight": "700"
              },
              {
                "font-size": "16px"
              },
              {
                "color": "#fff"
              }
            ],
            "label": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "11px"
              },
              {
                "color": "#d9c4f0"
              }
            ]
          }
        },
        "cc_room": {
          "template": "cc_card",
          "show_label": true,
          "variables": {
            "attr": null,
            "path": null
          },
          "label": "[[[ return variables.sub||\"\" ]]]",
          "custom_fields": {
            "t": "[[[ const tc=t=>t<18?'#6aa8f0':t<19.5?'#8fd0f0':t<=22.5?'#7fdc9a':t<=24?'#f3c156':'#f07a7a'; const v=Number(variables.attr?entity.attributes[variables.attr]:entity.state); if(isNaN(v)) return '—'; return `<span style=\"font:700 22px sans-serif;color:${tc(v)};text-shadow:0 0 12px ${tc(v)}55\">${v.toFixed(1)}<span style=\"font-size:14px\">°</span></span>` ]]]"
          },
          "styles": {
            "card": [
              {
                "padding": "10px 12px"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i n t\" \"i l t\""
              },
              {
                "grid-template-columns": "30px minmax(0,1fr) auto"
              },
              {
                "column-gap": "8px"
              }
            ],
            "icon": [
              {
                "width": "22px"
              },
              {
                "color": "#d9c4f0"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-weight": "600"
              },
              {
                "font-size": "13px"
              },
              {
                "color": "#fff"
              },
              {
                "white-space": "normal"
              },
              {
                "overflow": "visible"
              },
              {
                "text-overflow": "clip"
              },
              {
                "text-align": "left"
              },
              {
                "line-height": "1.15"
              }
            ],
            "label": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "11px"
              },
              {
                "color": "#9d8fb3"
              }
            ],
            "custom_fields": {
              "t": [
                {
                  "justify-self": "end"
                },
                {
                  "padding-right": "12px"
                }
              ]
            }
          },
          "extra_styles": "ha-card{position:relative}ha-card::after{content:'›';position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:20px;color:#f6d68a;opacity:.7}"
        },
        "cc_seg": {
          "variables": {
            "ent": "",
            "opt": ""
          },
          "show_label": false,
          "extra_styles": "ha-card{transition:transform .08s} ha-card:active{transform:translateY(3px)}",
          "styles": {
            "card": [
              {
                "border-radius": "14px"
              },
              {
                "padding": "8px 4px"
              },
              {
                "background": "[[[ return states[variables.ent]?.state===variables.opt?\"linear-gradient(180deg,#f6d68a,#d4a23c)\":\"rgba(38,28,58,.55)\" ]]]"
              },
              {
                "border": "[[[ return states[variables.ent]?.state===variables.opt?\"1px solid #f6d68a\":\"1px solid rgba(246,214,138,.22)\" ]]]"
              },
              {
                "box-shadow": "[[[ return states[variables.ent]?.state===variables.opt?\"0 0 14px rgba(246,214,138,.45), 0 2px 0 #7a5a1c\":\"0 4px 0 rgba(12,8,22,.75)\" ]]]"
              },
              {
                "backdrop-filter": "blur(16px)"
              },
              {
                "margin-bottom": "6px"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"i\" \"n\""
              }
            ],
            "icon": [
              {
                "width": "22px"
              },
              {
                "color": "[[[ return states[variables.ent]?.state===variables.opt?\"#2a1d44\":\"#d9c4f0\" ]]]"
              }
            ],
            "name": [
              {
                "font-size": "12px"
              },
              {
                "font-weight": "600"
              },
              {
                "color": "[[[ return states[variables.ent]?.state===variables.opt?\"#2a1d44\":\"#fff\" ]]]"
              }
            ]
          }
        }
      }
    }
  }
}