{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.ma_maison",
  "data": {
    "config": {
      "title": "Ma Maison",
      "background": {
        "image": "/local/images/wallpaper/ma-maison.jpg",
        "size": "cover",
        "attachment": "fixed"
      },
      "views": [
        {
          "title": "Entrée & Accès",
          "path": "entree",
          "icon": "mdi:door-closed",
          "type": "sections",
          "max_columns": 4,
          "header": {
            "card": {
              "type": "markdown",
              "content": "# 🚪 Ma Maison › Entrée & Accès\nInterphone, ouverture de porte et éclairages du hall.",
              "text_only": true,
              "card_mod": {
                "style": "ha-card { background: rgba(25, 18, 38, 0.72) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; box-shadow: none !important; padding: 12px 20px !important; }\nha-markdown { text-align: center !important; text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 2px 10px rgba(0,0,0,0.9), 0 0 2px rgba(0,0,0,1) !important; color: #f6d68a !important; }\n"
              }
            }
          },
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Visiophone & Ouverture",
                  "icon": "mdi:label-outline",
                  "variables": {
                    "sub": "BTicino Classe 300EOS",
                    "lights": []
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:bticino-intercom-card",
                  "intercoms": [
                    {
                      "name": "Platine de Rue",
                      "camera": "camera.hall_dentree_bticino_intercom_greg_et_sandrine_platine_de_rue",
                      "door_entity": "lock.hall_dentree_bticino_intercom_greg_et_sandrine_serrure",
                      "lock_entity": "lock.hall_dentree_bticino_intercom_greg_et_sandrine_serrure",
                      "auto_mic": true,
                      "door_actions": [
                        {
                          "entity": "lock.hall_dentree_bticino_intercom_greg_et_sandrine_serrure",
                          "service": "lock.unlock"
                        }
                      ]
                    }
                  ],
                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n"
                  },
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:mushroom-lock-card",
                  "entity": "lock.hall_dentree_bticino_intercom_greg_et_sandrine_serrure",
                  "name": "Serrure Entrée",
                  "icon": "mdi:lock-open-variant",
                  "primary_info": "name",
                  "secondary_info": "state",
                  "tap_action": {
                    "action": "call-service",
                    "service": "lock.unlock",
                    "target": {
                      "entity_id": "lock.hall_dentree_bticino_intercom_greg_et_sandrine_serrure"
                    }
                  },
                  "card_mod": {
                    "style": {
                      ".": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;border:1px solid rgba(246,214,138,.22)!important;box-shadow:0 4px 0 rgba(12,8,22,.75)!important;margin-bottom:6px}\nha-card {\n  background: rgba(38, 28, 58, 0.55) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n",
                      "mushroom-state-info": {
                        "$": ".secondary, .primary { white-space: normal !important; overflow: visible !important; text-overflow: unset !important; }\n"
                      }
                    }
                  },
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Chauffage & confort",
                  "icon": "mdi:home-thermometer",
                  "variables": {
                    "sub": "Température, humidité et mode de chauffage",
                    "lights": []
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:vertical-stack-in-card",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  },
                  "card_mod": {
                    "style": "ha-card{background:linear-gradient(135deg, rgba(60,40,96,.78), rgba(25,18,38,.78))!important;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-radius:20px!important;border:1px solid rgba(246,214,138,.35)!important;box-shadow:0 6px 0 rgba(12,8,22,.75),0 12px 30px rgba(0,0,0,.35)!important;margin-bottom:6px}"
                  },
                  "cards": [
                    {
                      "type": "custom:button-card",
                      "show_icon": false,
                      "show_name": false,
                      "tap_action": {
                        "action": "more-info",
                        "entity": "climate.couloir"
                      },
                      "triggers_update": [
                        "sensor.consigne_couloir",
                        "input_select.mode_couloir",
                        "binary_sensor.couloir_demande_de_chaleur",
                        "weather.forecast_maison"
                      ],
                      "custom_fields": {
                        "hd": "[[[ const mode=states['input_select.mode_couloir']?.state||''; const cs=states['sensor.consigne_couloir']?.state; const heat=states['binary_sensor.couloir_demande_de_chaleur']?.state==='on'; const ext=states['weather.forecast_maison']?.attributes?.temperature;\n  const pill=(x,col)=>`<span style=\"padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(246,214,138,.25);font-size:13px;color:${col||'#fff'};white-space:nowrap\">${x}</span>`;\n  return `<div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:8px;justify-content:space-between\">\n   <div style=\"text-align:left\"><div style=\"font:700 20px sans-serif;color:#f6d68a\">Mode ${mode}</div><div style=\"font-size:13px;color:#d9c4f0\">${cs==='off'?'Chauffage coupé':'Objectif '+cs+' °C'} · aiguille dorée = objectif</div></div>\n   <div style=\"display:flex;gap:6px;flex-wrap:wrap\">${pill(heat?'🔥 Chauffe':'● En attente',heat?'#f3a156':'#9d8fb3')}${ext!=null?pill('🌳 Dehors '+Number(ext).toFixed(1)+' °C'):''}</div></div>` ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "transparent"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "box-shadow": "none"
                          },
                          {
                            "padding": "14px 16px 0"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"hd\""
                          }
                        ],
                        "custom_fields": {
                          "hd": [
                            {
                              "justify-self": "stretch"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "horizontal-stack",
                      "cards": [
                        {
                          "type": "custom:gauge-card-pro",
                          "entity": "sensor.temp_couloir_sonoff_a480146b60_temperature",
                          "min": 14,
                          "max": 28,
                          "needle": true,
                          "needle_color": "#ffffff",
                          "gradient": true,
                          "gradient_resolution": "auto",
                          "round": "full",
                          "segments": [
                            {
                              "from": 14,
                              "color": "#2f5fa8"
                            },
                            {
                              "from": 17,
                              "color": "#6aa8f0"
                            },
                            {
                              "from": 19,
                              "color": "#7fdc9a"
                            },
                            {
                              "from": 22.5,
                              "color": "#7fdc9a"
                            },
                            {
                              "from": 24,
                              "color": "#f3c156"
                            },
                            {
                              "from": 26,
                              "color": "#f07a7a"
                            }
                          ],
                          "titles": {
                            "primary": {
                              "value": "Température",
                              "color": "#d9c4f0"
                            }
                          },
                          "value_texts": {
                            "primary": {
                              "color": "#ffffff",
                              "unit_of_measurement": "°C"
                            }
                          },
                          "tap_action": {
                            "action": "more-info"
                          },
                          "setpoint": {
                            "type": "entity",
                            "value": "sensor.consigne_couloir",
                            "color": "#f6d68a"
                          },
                          "card_mod": {
                            "style": "ha-card{background:transparent!important;border:none!important;box-shadow:none!important;backdrop-filter:none!important}"
                          }
                        },
                        {
                          "type": "custom:gauge-card-pro",
                          "entity": "sensor.temp_couloir_sonoff_a480146b60_humidity",
                          "min": 20,
                          "max": 80,
                          "needle": true,
                          "needle_color": "#ffffff",
                          "gradient": true,
                          "gradient_resolution": "auto",
                          "round": "full",
                          "segments": [
                            {
                              "from": 20,
                              "color": "#f3c156"
                            },
                            {
                              "from": 35,
                              "color": "#7fdc9a"
                            },
                            {
                              "from": 60,
                              "color": "#7fdc9a"
                            },
                            {
                              "from": 70,
                              "color": "#6aa8f0"
                            },
                            {
                              "from": 80,
                              "color": "#2f5fa8"
                            }
                          ],
                          "titles": {
                            "primary": {
                              "value": "Humidité",
                              "color": "#d9c4f0"
                            }
                          },
                          "value_texts": {
                            "primary": {
                              "color": "#ffffff",
                              "unit_of_measurement": "%"
                            }
                          },
                          "tap_action": {
                            "action": "more-info"
                          },
                          "card_mod": {
                            "style": "ha-card{background:transparent!important;border:none!important;box-shadow:none!important;backdrop-filter:none!important}"
                          }
                        }
                      ]
                    }
                  ]
