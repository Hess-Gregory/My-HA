                  "card_mod": {
                    "style": "ha-card{background:rgba(38,28,58,.55)!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px!important;{% set on=is_state('light.evier','on') %}{% set c=state_attr('light.evier','rgb_color') %}border:1px solid {% if on and c %}rgba({{c|join(',')}},.75){% elif on %}rgba(246,214,138,.8){% else %}rgba(246,214,138,.22){% endif %}!important;box-shadow:{% if on and c %}0 0 16px rgba({{c|join(',')}},.35),{% elif on %}0 0 14px rgba(246,214,138,.3),{% endif %}0 4px 0 rgba(12,8,22,.75)!important}"
                  },
                  "cards": [
                    {
