                      ],
                      "custom_fields": {
                        "c": "[[[ const R0=states['sensor.four_recettes']?.attributes?.recettes; const R=typeof R0==='string'?JSON.parse(R0):(R0||{}); const cat=states['input_select.four_recette_categorie']?.state; const nom=states['select.four_recette']?.state; const r=(R[cat]||[]).find(x=>x[0]===nom)||[]; const P={\"steam_modes_steam\":\"Vapeur\",\"heating_mode_hot_air\":\"Chaleur tournante\",\"heating_mode_top_bottom_heating\":\"Voûte / sole\",\"heating_mode_top_bottom_heating_eco\":\"Voûte/sole éco\",\"heating_mode_hot_air_grilling\":\"Gril air pulsé\",\"heating_mode_pizza_setting\":\"Pizza\",\"heating_mode_frozen_heatup_special\":\"Surgelés\",\"heating_mode_slow_cook\":\"Cuisson lente\",\"heating_mode_bottom_heating\":\"Sole\",\"heating_mode_keep_warm\":\"Maintien au chaud\",\"heating_mode_preheat_ovenware\":\"Chauffe-plats\",\"heating_mode_pre_heating\":\"Préchauffage\"}; if(!r[0]) return '<div style=\"color:#8a8a96\">Choisissez une recette</div>'; const [prep,niv]=(r[6]||'').split('~');\n  let reg=(P[r[1]]||r[1])+' · '+r[2]+' °C · '+r[3]+' min'+(r[4]?' · préchauffage rapide':''); if(r[8]) reg+=' → '+(P[r[8]]||r[8])+' · '+r[9]+' °C · '+r[10]+' min';\n  const row=(ic,t,x)=>x?`<div style=\"display:flex;gap:10px;align-items:flex-start;margin-top:10px\"><ha-icon icon=\"${ic}\" style=\"--mdc-icon-size:18px;width:18px;height:18px;color:#ff9d2e;flex:0 0 18px\"></ha-icon><div style=\"flex:1;min-width:0;text-align:left\"><div style=\"font-size:10px;letter-spacing:2px;color:#8a8a96\">${t}</div><div style=\"font-size:13px;color:#e8e8ee;line-height:1.35\">${x}</div></div></div>`:'';\n  return `<div style=\"text-align:left\"><div style=\"display:flex;align-items:center;gap:12px\"><div style=\"width:44px;height:44px;border-radius:50%;border:1px solid #ff9d2e;box-shadow:0 0 12px #ff9d2e66;display:flex;align-items:center;justify-content:center;flex:0 0 44px\"><ha-icon icon=\"${r[7]||'mdi:chef-hat'}\" style=\"--mdc-icon-size:22px;width:22px;height:22px;color:#ff9d2e\"></ha-icon></div>\n   <div style=\"min-width:0\"><div style=\"font-size:17px;font-weight:700;color:#fff\">${r[0]}</div><div style=\"font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;color:#ff9d2e\">${reg}</div></div></div>\n   ${row('mdi:chef-hat','PRÉPARATION',prep)}${row('mdi:tray-arrow-down','NIVEAU DANS LE FOUR',niv)}${r[5]?row('mdi:rotate-right','PENDANT LA CUISSON','Rappel sur le téléphone pour retourner à mi-cuisson.'):''}</div>` ]]]"
                      },
                      "extra_styles": "#container{white-space:normal!important}",
