                    },
                    "haptic": "medium"
                  },
                  "variables": {
                    "c1": "#5fd3cf",
                    "c2": "#1f8a86",
                    "c3": "#11524f"
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "cc_title",
                  "name": "Salon",
                  "icon": "mdi:television",
                  "variables": {
                    "sub": "Coin TV · éclairages",
                    "lights": [
                      "light.lustre_salon",
                      "light.salon_panneau_mural",
                      "light.salon_ambilight_tv"
                    ]
                  },
                  "grid_options": {
                    "columns": "full",
                    "rows": "auto"
                  },
                  "entity": "input_boolean.pdv_salon",
                  "tap_action": {
                    "action": "toggle",
                    "haptic": "light"
                  },
                  "custom_fields": {
                    "c": "[[[ return `<span style=\"font-size:22px;color:#f6d68a\">${entity.state==='on'?'▾':'▸'}</span>` ]]]"
                  },
                  "show_state": false,
                  "styles": {
                    "card": [
                      {
